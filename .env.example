# Use UMA das duas (anon "eyJ..." ou publishable "sb_publishable_..."):
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
